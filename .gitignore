# Build outputs (emcc emits both, plus the pthread worker shim)
.make/
public/randomx.js
public/randomx.wasm
public/randomx.worker.js
public/randomx_st.js
public/randomx_st.wasm
wasm/randomx.js
wasm/randomx.wasm
wasm/randomx.worker.js
wasm/randomx_st.js
wasm/randomx_st.wasm

# Node — `ws` is vendored under vendor/, so node_modules should never appear.
# Listed defensively in case someone runs `npm i` by reflex.
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Bench artefacts that may be redirected to disk
*.log
bench/results/

# Local overrides — do NOT commit a personalised wallet/pool config.
# (config.js itself is committed; this guards opt-in overrides if added.)
config.local.js
.env
.env.*

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
.AppleDouble
.LSOverride

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
.#*
\#*\#

# Stray compiler / toolchain outputs at repo root (emcc / clang scratch)
*.o
*.bc
a.out

# Local working notes; only the named shared project documents are included.
*.md
!README.md
!appendix_handoff.md
!proxy_handoff.md
!embed_progress.md
wasm/aes_relaxed/aes_relaxed.wasm
